{
  "name": "@comergehq/studio",
  "version": "0.1.32",
  "description": "Comerge studio",
  "main": "src/index.ts",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdelrahmanRizq97/comerge-studio.git"
  },
  "bugs": {
    "url": "https://github.com/AbdelrahmanRizq97/comerge-studio/issues"
  },
  "homepage": "https://github.com/AbdelrahmanRizq97/comerge-studio#readme",
  "license": "MIT",
  "author": "Comerge <abdelrahmanrizq97@gmail.com> (https://github.com/AbdelrahmanRizq97)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "@comergehq/studio-control": "^0.1.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-logs": "^5.5.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@callstack/liquid-glass": "*",
    "@supabase/supabase-js": "*",
    "@gorhom/bottom-sheet": "*",
    "@comergehq/runtime": "*",
    "expo": "*",
    "expo-asset": "*",
    "expo-file-system": "*",
    "expo-haptics": "*",
    "expo-linear-gradient": "*",
    "lottie-react-native": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "mixpanel-react-native": "*",
    "react-native-zip-archive": "*",
    "react-native-view-shot": "*"
  },
  "peerDependenciesMeta": {}
